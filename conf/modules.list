# ============================================================
# TuringOS 启动模块配置
# ============================================================

# ------------------------------------------------------------
# Entry: imx6ul-native-shell - i.MX6UL 原生 Shell
# ------------------------------------------------------------
entry imx6ul-native-shell

kernel fiasco -serial_esc
module sigma0
roottask moe rom/imx6ul-native-shell.cfg
module l4re
module ned
module imx6ul-native-shell.cfg
module native_shell
module libreadline.so

# ------------------------------------------------------------
# Entry: native-shell - 默认系统 (native_shell + fb-drv + ext4 + 网络)
# ------------------------------------------------------------
entry native-shell

kernel fiasco -serial_esc
module sigma0
roottask moe rom/native-shell.cfg
module l4re
module ned
module native-shell.cfg
module virt-full.io
module io
module rtc
module virtio-block-driver
module ext4fs
module fb-drv
module native_shell
module libreadline.so
module cyclictest
module ipcbench

# ------------------------------------------------------------
# Entry: demo - 默认演示系统 (使用 native_shell)
# ------------------------------------------------------------
entry demo

# 内核
kernel fiasco -serial_esc

# 初始内存管理器
module sigma0

# 根任务服务器，直接启动 native_shell（不通过 ned）
roottask moe /bin/native_shell

# L4Re 核心库和工具 - native_shell 可能需要
module l4re

# native_shell 可执行程序
module native_shell

# Readline 和 history 库
module libreadline.so

# ------------------------------------------------------------
# Entry: native - 直接启动 native_shell (不使用 ned)
# ------------------------------------------------------------
entry native

kernel fiasco -serial_esc
module sigma0
roottask /bin/native_shell
module l4re

# native_shell 和依赖库
module native_shell
module libreadline.so

