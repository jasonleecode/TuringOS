# ============================================================
# TuringOS 启动模块配置
# ============================================================

# ------------------------------------------------------------
# Entry: demo - 默认演示系统 (使用 native_shell)
# ------------------------------------------------------------
entry demo

# 内核
kernel fiasco -serial_esc

# 初始内存管理器
module sigma0

# 根任务服务器，直接启动 native_shell（不通过 ned）
roottask moe /bin/native_shell

# L4Re 核心库和工具 - native_shell 可能需要
module l4re

# native_shell 可执行程序
module native_shell

# Readline 和 history 库
module libreadline.so

# ------------------------------------------------------------
# Entry: native - 直接启动 native_shell (不使用 ned)
# ------------------------------------------------------------
entry native

kernel fiasco -serial_esc
module sigma0
roottask /bin/native_shell
module l4re

# native_shell 和依赖库
module native_shell
module libreadline.so

# ------------------------------------------------------------
# Entry: fiasco-base-test - 基础测试系统 (启动 hello)
# ------------------------------------------------------------
entry fiasco-base-test

kernel fiasco -serial_esc
module sigma0
roottask moe rom/hello
module l4re
module ned
module hello

# ------------------------------------------------------------
# Entry: shell - Lua 交互式 shell (通过 ned)
# ------------------------------------------------------------
entry shell

kernel fiasco -serial_esc
module sigma0
roottask moe rom/shell
module l4re
module ned

# ------------------------------------------------------------
# Entry: fb-test - 帧缓冲显示测试 (需要 QEMU --gpu 启动)
# ------------------------------------------------------------
entry fb-test

kernel fiasco -serial_esc
module sigma0
roottask moe rom/fb-test.cfg
module l4re
module ned
module fb-test.cfg
module fb-test

# ------------------------------------------------------------
# Entry: tcp-server - TCP echo server (virtio-net + lwIP)
# ------------------------------------------------------------
entry tcp-server

kernel fiasco -serial_esc
module sigma0
roottask moe rom/tcp-server.cfg
module l4re
module ned
module tcp-server.cfg
module virt-net.io
module io
module tcp_server

# ------------------------------------------------------------
# Entry: virt-blk - VirtIO block driver test
# ------------------------------------------------------------
entry virt-blk

kernel fiasco -serial_esc
module sigma0
roottask moe rom/virt-blk.cfg
module l4re
module ned
module virt-blk.cfg
module virt-blk.io
module io
module virtio-block-driver
module ext4fs
