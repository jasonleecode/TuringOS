/**
 * 文件路径: pkg/my_servers/include/console.idl
 * 描述: 自定义控制台服务的 IPC 接口定义
 */

#pragma once

#include <l4/sys/cxx/ipc_iface>

namespace My_OS {

// 定义一个名为 Console_srv 的接口，并分配一个唯一的协议 ID (例如 0x434f4e)
L4_RPC_IFACE(Console_srv, 0x434f4e);

  // 接口方法 1：向屏幕打印字符串
  // 输入参数：字符串指针 (str)，字符串长度 (len)
  // 返回值：成功打印的字符数 (int)
  L4_RPC_METHOD(int, write, (char const *str, unsigned int len));

  // 接口方法 2：从键盘读取一个字符
  // 输出参数：读取到的字符 (ch)
  // 返回值：状态码 (int, 0表示成功，负数表示超时或无输入)
  L4_RPC_METHOD(int, read, (char *ch));

}; // namespace My_OS
