menu "RTC"

config RTC_DS3231
        bool "DS3231"
        depends on HAVE_BIDPC_I2C_DRIVER

config RTC_PCF85063A
        bool "NXP PCF85063A RTC chip"
        depends on HAVE_BIDPC_I2C_DRIVER

config RTC_AM335X
        bool "AM335x on-chip RTC (BeagleBone Black)"
        default y
        help
          On-chip RTC module of the TI AM335x SoC.
          Uses MMIO registers at 0x44E3E000, no I2C required.

comment "Some RTC drivers might be unavailable due to missing i2c-driver package."
        depends on !HAVE_BIDPC_I2C_DRIVER

endmenu
